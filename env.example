# FileDeck configuration. Non-secret values only: secrets live in ./secrets (see scripts/init-secrets.sh).
# Copy to .env and edit.

# The exact origin users type in the browser (scheme + host [+ port]). Used for CSRF/Origin checks.
PUBLIC_URL=https://filedeck.example.com

# --- exposure -------------------------------------------------------------
# Bind the web port to localhost and let Nginx Proxy Manager forward to it.
FILEDECK_BIND=127.0.0.1
FILEDECK_HTTP_PORT=8088

# --- servers that ask for MFA approval ----------------------------------------------
# A server marked "asks for approval (MFA)" is never connected to automatically, uses one connection, and waits up to this
# long for someone to approve the sign-in. A reverse proxy in front of FileDeck must allow requests this long (docs).
MFA_CONNECT_TIMEOUT_SECONDS=120

# --- terminal -------------------------------------------------------------------
# Web SSH terminals are off until an administrator enables them per server (server settings). A terminal runs commands as
# the server's SSH account, regardless of folder permissions. These limits bound how long and how many sessions can run.
# The reverse proxy must pass WebSockets (Nginx Proxy Manager: tick "Websockets support"). See docs/operations.md.
TERMINAL_IDLE_MINUTES=30
TERMINAL_MAX_HOURS=12
TERMINAL_MAX_PER_USER=3
TERMINAL_MAX_PER_SERVER=8

# --- editor ----------------------------------------------------------------------
# Text files up to EDITOR_MAX_BYTES open for editing; up to EDITOR_LARGE_MAX_BYTES only after the user confirms;
# bigger files are shown read-only (first EDITOR_READONLY_HEAD_BYTES) with a Download button. The reverse proxy must
# allow a request body of EDITOR_LARGE_MAX_BYTES on the save endpoint (docs/operations.md).
EDITOR_MAX_BYTES=5242880
EDITOR_LARGE_MAX_BYTES=20971520
EDITOR_READONLY_HEAD_BYTES=1048576

# --- files ----------------------------------------------------------------
# Host directory exposed to FileDeck as /mnt/data. Create FileDeck "local" roots under /mnt/... in the UI/API.
FILEDECK_DATA_DIR=./data/files
# Run the containers as the owner of that directory (find yours with `id -u` / `id -g`).
FILEDECK_UID=1000
FILEDECK_GID=1000

# --- sessions ---------------------------------------------------------------
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=30
# Cookie settings. Keep the defaults behind HTTPS. For plain-HTTP local testing ONLY, set:
#   SESSION_COOKIE_SECURE=false
#   SESSION_COOKIE_NAME=filedeck_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-filedeck_session

# --- transfers ------------------------------------------------------------------
UPLOAD_CHUNK_SIZE=8388608
MAX_CONCURRENT_UPLOADS=3
TRANSFER_STAGING_RETENTION_HOURS=72
SFTP_CONNECTION_TIMEOUT_MS=10000
SFTP_MAX_CONNECTIONS_PER_SERVER=4
# Uploads are staged on the `staging` volume before the worker writes them to the destination: size that volume for
# (concurrent uploads x file size). New uploads are refused (507) when free space would drop below STAGING_MIN_FREE_BYTES.
MAX_UPLOAD_BYTES=1099511627776          # 1 TiB per file
STAGING_MIN_FREE_BYTES=1073741824       # keep 1 GiB free on the staging volume
USER_ACTIVE_UPLOADS=10                  # unfinished uploads per user
USER_STAGING_QUOTA_BYTES=214748364800   # 200 GiB of unfinished uploads per user
MAX_CONCURRENT_CHUNK_WRITES=8           # chunk requests written at once, server-wide (the rest get 429 + Retry-After)
TRANSFER_HISTORY_DAYS=30                # finished transfers stay in the Transfers list this long
ZIP_MAX_BYTES=21474836480               # 20 GiB per ZIP download
ZIP_MAX_ENTRIES=10000
SERVER_COPY_MAX_ENTRIES=100000          # files in one cross-folder / cross-server copy or move
SSE_MAX_CONNECTIONS_PER_USER=5          # open live-update streams (browser tabs) per user
RATE_LIMIT_PER_MINUTE=1200              # requests per client per minute (chunk uploads are exempt)

# --- files ---------------------------------------------------------------------
# Deleted items sit in a hidden per-folder Trash for this many days (0 = keep forever).
TRASH_RETENTION_DAYS=30
# Copies inside one folder tree run in the request; bigger ones are refused (use a cross-folder copy, which runs in the background).
COPY_INLINE_MAX_BYTES=1073741824
COPY_INLINE_MAX_ENTRIES=10000
PREVIEW_MAX_IMAGE_BYTES=26214400

# --- operations -------------------------------------------------------------
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=info
BOOTSTRAP_ADMIN_USERNAME=admin
# Raise after rotating credential keys (see docs/operations.md)
CREDENTIAL_ACTIVE_KEY_VERSION=1

# Monitoring (live server metrics over SSH, same access as the terminal)
# MONITOR_IDLE_SECONDS=30
# MONITOR_SAMPLES_PER_MINUTE=120
