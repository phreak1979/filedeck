# .env for compose-github.yaml / compose.image.yaml (the single FileDeck image + PostgreSQL).
# Copy to .env and fill in the six values marked REQUIRED. Names are case-sensitive. No spaces around "=", no quotes.
# Easiest: let the image write all of this for you:
#   docker run --rm ghcr.io/phreak1979/filedeck:latest init-secrets > .env       (then change PUBLIC_URL)

# REQUIRED. The exact address people type in the browser (scheme + host [+ port]).
PUBLIC_URL=https://filedeck.example.com

# REQUIRED. Letters and digits only (no symbols), at least 20 characters:  openssl rand -hex 20
POSTGRES_PASSWORD=change-me-letters-and-digits-only

# REQUIRED. The same password again. The host name must stay "postgres" (the database service in the compose file).
DATABASE_URL=postgresql://filedeck:change-me-letters-and-digits-only@postgres:5432/filedeck

# REQUIRED. At least 32 characters:  openssl rand -base64 48
CSRF_SECRET=change-me-at-least-32-random-characters-long

# REQUIRED. Encrypts the server passwords/keys you store. A JSON object, keep it on ONE line:
#   openssl rand -base64 32     then put the result in place of the text below.
# BACK THIS UP separately from the database: without it, stored server credentials cannot be recovered.
CREDENTIAL_KEYS={"1":"replace-with-32-random-bytes-in-base64"}

# REQUIRED. The first administrator, created only when the database is empty. At least 12 characters.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-characters

# --- optional -------------------------------------------------------------------------------------------
# Where the web port is published on the host (127.0.0.1 = only this machine; put an HTTPS proxy in front).
FILEDECK_BIND=127.0.0.1
FILEDECK_HTTP_PORT=8088
# Host folder shown to FileDeck as /mnt/data (create "local" folders under /mnt in the app).
FILEDECK_DATA_DIR=./data/files
# Plain-HTTP testing ONLY (never behind HTTPS): uncomment both.
#SESSION_COOKIE_SECURE=false
#SESSION_COOKIE_NAME=filedeck_session
# Web terminal limits: minutes without typing before a terminal is closed, and the longest one may stay open.
TERMINAL_IDLE_MINUTES=60
TERMINAL_MAX_HOURS=12
TERMINAL_MAX_PER_USER=3
TERMINAL_MAX_PER_SERVER=8
TERMINAL_TICKETS_PER_MINUTE=30          # terminal connection attempts per user per minute

# Sessions and sign-in
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=30

# Servers that ask for MFA approval: how long a connection waits for someone to approve (seconds).
MFA_CONNECT_TIMEOUT_SECONDS=120

# Editor: files up to EDITOR_MAX_BYTES open for editing; up to EDITOR_LARGE_MAX_BYTES only after confirming; bigger are read-only.
EDITOR_MAX_BYTES=5242880
EDITOR_LARGE_MAX_BYTES=20971520
EDITOR_READONLY_HEAD_BYTES=1048576

# Transfers and uploads
UPLOAD_CHUNK_SIZE=8388608
MAX_CONCURRENT_UPLOADS=3
TRANSFER_STAGING_RETENTION_HOURS=72
SFTP_CONNECTION_TIMEOUT_MS=10000
SFTP_MAX_CONNECTIONS_PER_SERVER=4
MAX_UPLOAD_BYTES=1099511627776          # 1 TiB per file
STAGING_MIN_FREE_BYTES=1073741824       # keep 1 GiB free on the staging volume
USER_ACTIVE_UPLOADS=10                  # unfinished uploads per user
USER_STAGING_QUOTA_BYTES=214748364800   # 200 GiB of unfinished uploads per user
MAX_CONCURRENT_CHUNK_WRITES=8           # chunk requests written at once, server-wide
TRANSFER_HISTORY_DAYS=30                # finished transfers stay in the Transfers list this long
ZIP_MAX_BYTES=21474836480               # 20 GiB per ZIP download
ZIP_MAX_ENTRIES=10000
SERVER_COPY_MAX_ENTRIES=100000          # files in one cross-folder / cross-server copy or move
SSE_MAX_CONNECTIONS_PER_USER=5          # open live-update streams (browser tabs) per user
RATE_LIMIT_PER_MINUTE=1200              # requests per client per minute (chunk uploads are exempt)
JSON_BODY_LIMIT_BYTES=1048576           # largest JSON request body (1 MiB)

# Files
TRASH_RETENTION_DAYS=30                 # 0 = keep trashed items forever
COPY_INLINE_MAX_BYTES=1073741824
COPY_INLINE_MAX_ENTRIES=10000
PREVIEW_MAX_IMAGE_BYTES=26214400
SEARCH_MAX_ENTRIES=0                    # 0 = built-in defaults (local 100k entries / 8 s, SFTP 20k / 5 s)
SEARCH_MAX_MS=0

# Operations
AUDIT_RETENTION_DAYS=90
LOG_LEVEL=info
# Raise after rotating credential keys (see docs/operations.md)
CREDENTIAL_ACTIVE_KEY_VERSION=1

# Monitoring (live server metrics over SSH, same access as the terminal)
#MONITOR_IDLE_SECONDS=30
#MONITOR_SAMPLES_PER_MINUTE=120

# Host health: this server's own CPU, memory and disks in FileDeck (admins only, off by default).
# Needs the commented read-only mounts in the compose file (/proc, /sys and each disk under /host/disks/) AND this:
#HOST_HEALTH_ENABLED=true
#HOST_HEALTH_SAMPLES_PER_MINUTE=60
